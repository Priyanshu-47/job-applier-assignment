# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/job_alerts

# LLM Configuration
# Options: fake, openai
LLM_PROVIDER=fake

# OpenAI Configuration (only needed when LLM_PROVIDER=openai)
# OPENAI_API_KEY=your-api-key-here
# OPENAI_MODEL=gpt-3.5-turbo

# Application
NODE_ENV=development
PORT=3000
